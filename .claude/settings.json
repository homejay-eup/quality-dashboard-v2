{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"if (Get-Command rtk -ErrorAction SilentlyContinue) { rtk hook claude }\""
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/_開發檔案/scripts/hooks/verify-gate.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/_開發檔案/scripts/hooks/mark-verify.ps1\""
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
